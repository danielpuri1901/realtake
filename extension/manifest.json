{
  "manifest_version": 3,
  "name": "RealTake",
  "version": "0.1.0",
  "description": "See what Reddit really thinks before you buy SaaS or subscriptions",

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "service-worker.js"
  },

  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*"
  ]
}
